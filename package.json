{
  "name": "@b55585wy/feishu-codex-bridge",
  "version": "0.6.14",
  "description": "Private edition: control existing Codex sessions and send module completion notifications through Feishu",
  "type": "module",
  "bin": {
    "feishu-codex-bridge": "bin/feishu-codex-bridge.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "extensions",
    "scripts/build-private.cjs",
    "scripts/codex-managed.ps1",
    "scripts/test-extensions.cjs",
    "scripts/configure-private.cjs"
  ],
  "scripts": {
    "build": "node scripts/build-private.cjs",
    "dev": "node scripts/build-private.cjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fleet": "vitest run fleet-",
    "test:native-service": "node scripts/test-native-service.mjs",
    "start": "node bin/feishu-codex-bridge.mjs run",
    "prepare": "npm run build",
    "release": "bash scripts/release.sh",
    "test:extensions": "node scripts/test-extensions.cjs",
    "test:all": "npm test && npm run test:extensions",
    "setup:private": "node scripts/configure-private.cjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "axios": "1.21.0",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "https-proxy-agent": "5.0.1",
    "ogg-opus-decoder": "^1.7.5",
    "qrcode-terminal": "^0.12.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.178",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "feishu",
    "lark",
    "codex",
    "app-server",
    "cli",
    "bridge",
    "bot"
  ],
  "author": "modelzen",
  "license": "MIT",
  "homepage": "https://github.com/b55585wy/feishu-codex-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b55585wy/feishu-codex-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/b55585wy/feishu-codex-bridge/issues"
  },
  "private": true
}
